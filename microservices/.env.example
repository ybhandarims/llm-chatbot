# Environment Variables Configuration
# Copy this file to .env and fill in with your actual values

# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MOCK=true

# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# For LocalStack development:
# AWS_ENDPOINT_URL=http://localstack:4566

# ==========================================
# SQS Configuration
# ==========================================
SQS_QUEUE_URL=http://localstack:4566/000000000000/ai-jobs
DLQ_URL=http://localstack:4566/000000000000/ai-jobs-dlq

# ==========================================
# Service URLs
# ==========================================
SETTINGS_URL=http://settings:8001
CONVERSATIONS_URL=http://conversations:8002
MESSAGES_URL=http://messages:8003
GATEWAY_URL=http://gateway:8080
MESSAGES_SERVICE_URL=http://messages:8003
CONVERSATIONS_SERVICE_URL=http://conversations:8002

# ==========================================
# DynamoDB Configuration
# ==========================================
DYNAMODB_TABLE=conversations
# For LocalStack development - also set AWS_ENDPOINT_URL above

# ==========================================
# Frontend Configuration
# ==========================================
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
SERVICE_NAME=chatbot

# ==========================================
# AI Configuration
# ==========================================
SYSTEM_PROMPT=You are a helpful assistant for coding and technical questions.
TEMPERATURE=0.7
MAX_TOKENS=512

# ==========================================
# LocalStack Configuration (Development Only)
# ==========================================
# Set to true to use LocalStack for local development
USE_LOCALSTACK=true
